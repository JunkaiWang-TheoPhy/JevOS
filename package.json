    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0"
  }
