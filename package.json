{
  "name": "jevos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0 <23 || >=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "node --env-file-if-exists=.env.local server/index.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "node --env-file-if-exists=.env.local server/index.mjs --static",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs drafts/vibeos-next/app-pack/data-studio/*.test.mjs",
    "test:pwa": "playwright test",
    "check": "npm run lint && npm run build && npm test",
    "doctor": "node scripts/doctor.mjs",
    "build:pages": "VITE_SITE_BUILD=true VITE_BASE_PATH=/JevOS/ npm run build"
  },
  "dependencies": {
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0"
  }
}
