# Server-side only. Never use a VITE_ prefix for API keys.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# If this machine requires its configured HTTP(S) proxy, Node 22.21+ supports:
# NODE_USE_ENV_PROXY=1
# Persistent database; defaults to .data/vibeos.sqlite in this project.
# VIBEOS_DB_PATH=/absolute/path/to/vibeos.sqlite
MAX_DECISIONS_PER_DAY=1000
# Separate code-generation model. Jev only chooses among bounded options.
# OpenAI-compatible Chat Completions API; all credentials remain server-side.
APP_GENERATOR_API_KEY=
APP_GENERATOR_MODEL=
APP_GENERATOR_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY / OPENAI_MODEL / OPENAI_BASE_URL are also accepted.
# npm run dev uses port 4107 for the API and 5173 for Vite.
# npm run preview serves both the API and production PWA on 4173.
# For an HTTPS deployment, set the exact public origin (without trailing slash).
# ALLOWED_ORIGIN=https://vibeos.example.com

# Optional generation reasoning effort; blank keeps the provider default.
APP_GENERATOR_REASONING_EFFORT=
# Use a distinct cookie name when comparing two localhost versions.
# VIBEOS_SESSION_COOKIE=jevos-next-session
